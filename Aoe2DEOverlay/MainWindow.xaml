<Window x:Class="Aoe2DEOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AoE2 Minimal Overlay"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Width="380"
        SizeToContent="Height"
        MaxHeight="900"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AEB4BE"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Border Background="#F0121418" BorderBrush="#4A5059" BorderThickness="1" CornerRadius="5">
        <Grid>
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="AoE2 · waiting for match"
                           Foreground="#C8CDD5" FontSize="12" Margin="12,10" />
                <ItemsControl x:Name="PlayersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#30353C" BorderThickness="0,1,0,0" Padding="12,9,12,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="#F2F4F7" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding WinRate}" Foreground="#E4E7EB" FontSize="12"/>
                                            <TextBlock Text=" · " Foreground="#69717D" FontSize="12"/>
                                            <TextBlock Text="{Binding Record}" Foreground="#BEC4CC" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="1v1 " Style="{StaticResource SecondaryText}"/>
                                            <TextBlock Text="{Binding OneVsOneRating}" Foreground="#EFF1F4" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="TG  " Style="{StaticResource SecondaryText}"/>
                                            <TextBlock Text="{Binding TeamRating}" Foreground="#EFF1F4" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding RecentCivilizations}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#252A31" BorderBrush="#3B424C" BorderThickness="1" CornerRadius="3"
                                                        Margin="0,0,5,0" Padding="5,2">
                                                    <TextBlock Text="{Binding}" Foreground="#C7CCD3" FontSize="9" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Border x:Name="UnlockedIndicator" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#A6343941" CornerRadius="2" Padding="4,2" Margin="0,5,5,0" Visibility="Collapsed">
                <TextBlock Text="UNLOCKED" Foreground="#CBD0D7" FontSize="8" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</Window>


