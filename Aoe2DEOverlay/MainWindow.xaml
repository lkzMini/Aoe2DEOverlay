<Window x:Class="Aoe2DEOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AoE2 Minimal Overlay"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Width="570"
        SizeToContent="Height"
        MaxHeight="900"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B8BEC8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Border Background="#C9121418" BorderBrush="#4A5059" BorderThickness="1" CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="DragArea" Grid.Row="0" Margin="10,0,7,0" Background="Transparent" MouseLeftButtonDown="DragWhenUnlocked">
                <TextBlock x:Name="StatusText" Text="AoE2 · waiting for match" VerticalAlignment="Center"
                           Foreground="#C8CDD5" FontSize="12"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border x:Name="UnlockedIndicator" Background="#A6343941" CornerRadius="2" Padding="4,2"
                            Margin="0,0,6,0" Visibility="Collapsed">
                        <TextBlock Text="UNLOCKED" Foreground="#CBD0D7" FontSize="8" FontWeight="SemiBold"/>
                    </Border>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Visibility="Collapsed"
                            Width="19" Height="19" Padding="0" BorderThickness="0" Background="Transparent"
                            Foreground="#D7DCE3" FontSize="15" FontWeight="SemiBold" ToolTip="Close overlay">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="buttonBorder" Background="{TemplateBinding Background}" CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="buttonBorder" Property="Background" Value="#A33E454F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        ×
                    </Button>
                </StackPanel>
            </Grid>
            <ItemsControl x:Name="PlayersList" Grid.Row="1">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#343940" BorderThickness="0,1,0,0" Padding="10,5,10,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="25" Height="21" CornerRadius="3" Background="{Binding SlotBadgeBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Slot}" Foreground="{Binding SlotBadgeForeground}" FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F2F4F7" FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WinRate}" Foreground="#F0F3F6" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text=" · " Foreground="#7B8490" FontSize="13"/>
                                        <TextBlock Text="{Binding Record}" Foreground="#CFD4DB" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" Margin="30,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="1v1 " Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Text="{Binding OneVsOneRating}" Foreground="#F0F3F6" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="TG  " Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Text="{Binding TeamRating}" Foreground="#F0F3F6" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding RecentCivilizations}" Margin="30,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#262B32" BorderBrush="#404751" BorderThickness="1" CornerRadius="3"
                                                    Margin="0,0,5,0" Padding="6,2">
                                                <TextBlock Text="{Binding}" Foreground="#D6DBE2" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
